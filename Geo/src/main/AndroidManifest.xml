<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        ACCESS_BACKGROUND_LOCATION was previously declared but never
        actually requested at runtime. iOS only asks for WhenInUse
        (Location's initialize() requestWhenInUseAuthorization comment
        explicitly cites Apple guideline 5.1.1(i) data minimisation),
        and we route background sampling through WorkManager which
        doesn't need background-location. Keeping it would also
        trigger Play Store review for a feature we don't use.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <application
        android:name=".GeoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Geo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Geo"
        tools:targetApi="35">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Geo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home screen widget -->
        <receiver
            android:name=".widget.GeoWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/geo_widget_info" />
        </receiver>

        <!-- Widget configuration screen — opens on first pin AND when
             the user taps the reconfigure affordance. Mirrors iOS
             AppIntent toggles for showing GPS / barometer. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Geo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Listens for `/geo/snapshot` messages pushed from the
             paired Wear OS device. Persists each (throttled) inbound
             token into Room history via WearInboundListener. -->
        <service
            android:name=".connectivity.WearInboundListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/geo/" />
            </intent-filter>
        </service>

        <!--
            GeoApplication implements androidx.work.Configuration.Provider so
            WorkManager initialises on demand with our HiltWorkerFactory. The
            androidx.work AAR otherwise auto-merges its default
            WorkManagerInitializer into androidx.startup's
            InitializationProvider, which would race with the on-demand init
            and trigger lint's RemoveWorkManagerInitializer fatal. We merge
            into the existing InitializationProvider node and drop the
            WorkManagerInitializer meta-data.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
